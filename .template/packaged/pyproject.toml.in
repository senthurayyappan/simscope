[project]
name = {{name_json}}
version = "0.1.0"
description = {{description_json}}
readme = "README.md"
{{license_field}}authors = [{ name = {{author_json}} }]
requires-python = ">={{python}}"
dependencies = []

[project.urls]
Repository = "https://github.com/{{owner}}/{{repo}}"
Documentation = "https://{{owner}}.github.io/{{repo}}/"

[build-system]
requires = ["uv_build>=0.12.5,<0.13"]
build-backend = "uv_build"
{{project_scripts}}
[dependency-groups]
dev = [
    "pytest>=8",
    "pytest-cov>=6",
    "pre-commit>=4",
    "ruff>=0.15.17",
    "ty>=0.0.72",
    "deptry>=0.24",
]
docs = [
    "mkdocs>=1.6.1,<2",
    "mkdocs-shadcn>=0.12,<0.13",
    "mkdocstrings[python]>=1,<2",
    "pymdown-extensions>=10",
]

[tool.ruff]
line-length = 80
target-version = "py{{python_digits}}"
src = ["src"]

[tool.ruff.lint]
select = ["E", "F", "W", "I", "UP", "B", "C4", "SIM", "RUF", "N", "A", "G", "T10", "PGH", "D"]

[tool.ruff.lint.pydocstyle]
convention = "google"

[tool.ruff.lint.per-file-ignores]
"tests/**/*.py" = ["D"]

[tool.ruff.format]
quote-style = "double"
docstring-code-format = true

[tool.ty.src]
include = ["src", "tests", ".github/scripts"]

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = ["--strict-config", "--strict-markers", "--import-mode=importlib"]

[tool.coverage.run]
branch = true
source = ["src"]
omit = ["tests/*"]

[tool.coverage.report]
show_missing = true
skip_empty = true

[tool.deptry]
known_first_party = ["{{module}}"]
