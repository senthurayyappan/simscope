name: CI
on:
{{push_trigger}}{{pull_request_trigger}}  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: ci-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true
jobs:
  quality:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: {{action_checkout}}
        with:
          persist-credentials: false
      - uses: {{action_setup_uv}}
        with:
          enable-cache: true
      - run: uv sync --locked
      - run: uv run pre-commit run --all-files
      - run: uv run --group docs mkdocs build --strict
      - run: uv build --no-sources
  tests:
    name: Python ${{ matrix.python }} / ${{ matrix.os }}
    strategy:
      fail-fast: false
      matrix:
        python: {{python_matrix}}
        os: [ubuntu-latest]
        include:
          - python: "{{python}}"
            os: windows-latest
          - python: "{{python}}"
            os: macos-latest
    runs-on: ${{ matrix.os }}
    timeout-minutes: 15
    steps:
      - uses: {{action_checkout}}
        with:
          persist-credentials: false
      - uses: {{action_setup_uv}}
        with:
          python-version: ${{ matrix.python }}
          enable-cache: true
      - run: uv sync --locked
      - run: uv run pytest --cov --cov-report=term-missing
