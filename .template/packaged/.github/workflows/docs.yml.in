name: Docs
on:
{{push_trigger}}  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: docs
  cancel-in-progress: false
jobs:
  deploy:
    if: vars.DEPLOY_DOCS == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: write
    steps:
      - uses: {{action_checkout}}
        with:
          fetch-depth: 0
      - uses: {{action_setup_uv}}
        with:
          enable-cache: false
      - run: uv sync --locked --group docs
      - name: Deploy documentation
        env:
          GIT_COMMITTER_NAME: github-actions[bot]
          GIT_COMMITTER_EMAIL: 41898282+github-actions[bot]@users.noreply.github.com
        run: uv run --group docs mkdocs gh-deploy --strict
