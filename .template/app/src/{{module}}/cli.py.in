"""Command-line interface for {{name}}."""

import argparse


def greet(name: str) -> str:
    """Return a greeting for a name that is not blank.

    Args:
        name: Name of the person to greet.

    Returns:
        A greeting with whitespace removed from both ends of the name.

    Raises:
        ValueError: If the name is blank.
    """
    cleaned = name.strip()
    if not cleaned:
        raise ValueError("name must not be blank")
    return f"Hello, {cleaned}!"


def main(argv: list[str] | None = None) -> None:
    """Run the command-line interface.

    Args:
        argv: Arguments to parse. Defaults to the process arguments.
    """
    parser = argparse.ArgumentParser(prog="{{name}}")
    subcommands = parser.add_subparsers(dest="command", required=True)
    hello = subcommands.add_parser(
        "hello",
        help="Greet someone by name.",
    )
    hello.add_argument(
        "name",
        nargs="?",
        default="world",
        help="Who to greet.",
    )
    args = parser.parse_args(argv)
    try:
        message = greet(args.name)
    except ValueError as exc:
        parser.error(str(exc))
    print(message)
