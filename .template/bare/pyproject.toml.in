[project]
name = {{name_json}}
version = "0.1.0"
description = {{description_json}}
readme = "README.md"
{{license_field}}authors = [{ name = {{author_json}} }]
requires-python = ">={{python}}"
dependencies = []

[project.urls]
Repository = "https://github.com/{{owner}}/{{repo}}"

[tool.uv]
package = false

[dependency-groups]
dev = [
    "pytest>=8",
    "pre-commit>=4",
    "ruff>=0.15.17",
    "ty>=0.0.72",
]

[tool.ruff]
line-length = 80
target-version = "py{{python_digits}}"

[tool.ruff.lint]
select = ["E", "F", "W", "I", "UP", "B", "C4", "SIM", "RUF", "N", "A", "G", "T10", "PGH"]

[tool.ruff.lint.per-file-ignores]
"**/*.ipynb" = ["E402", "I"]

[tool.ruff.format]
quote-style = "double"
docstring-code-format = true

[tool.ty.src]
include = ["experiments", "tests"]

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = ["--strict-config", "--strict-markers", "--import-mode=importlib"]
pythonpath = ["."]
