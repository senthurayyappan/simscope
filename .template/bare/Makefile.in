.DEFAULT_GOAL := help
.PHONY: help install check lint format typecheck test

help: ## Show available commands
	@awk 'BEGIN {FS = ":.*## "} /^[a-zA-Z_-]+:.*## / {printf "%-16s %s\n", $$1, $$2}' $(MAKEFILE_LIST)

install: ## Install development tools and the Git hook
	uv sync
	uv run pre-commit install

check: ## Run pre-commit and static checks
	uv run pre-commit run --all-files

lint: ## Check lint and formatting without changing files
	uv run ruff check .
	uv run ruff format --check .

format: ## Apply safe lint fixes and format
	uv run ruff check --fix .
	uv run ruff format .

typecheck: ## Check types with ty
	uv run ty check

test: ## Run the test suite
	uv run pytest
